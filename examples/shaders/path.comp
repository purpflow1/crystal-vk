#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D outputImage;

layout(push_constant) uniform PushConstants {
    float time;
    uint frameNum;
    float aperture;
    float focalDist;
    int samplesPerFrame;
} pc;

// ------------------------------------------------------------------
// Random number generator (PCG)
uint rng_state;

void init_rng(uint seed) {
    rng_state = seed;
}

uint pcg_hash(uint inpt) {
    uint state = inpt * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand() {
    rng_state = pcg_hash(rng_state);
    return float(rng_state) / 4294967295.0f;
}
// ------------------------------------------------------------------

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct Sphere {
    vec3 center;
    float radius;
    vec3 albedo;
};

const int sphereCount = 3;
Sphere spheres[sphereCount] = Sphere[sphereCount](
        Sphere(vec3(0.0, -100.5, -1.0), 100.0, vec3(0.8, 0.8, 0.8)),
        Sphere(vec3(0.0, 0.0, -1.2), 0.5, vec3(1.0, 0.2, 0.2)),
        Sphere(vec3(0.8, 0.3, -1.8), 0.4, vec3(0.2, 0.2, 1.0))
    );

bool hitSphere(const Sphere s, Ray r, float tMin, float tMax, out float t, out vec3 normal) {
    vec3 oc = r.origin - s.center;
    float a = dot(r.dir, r.dir);
    float b = dot(oc, r.dir);
    float c = dot(oc, oc) - s.radius * s.radius;
    float discriminant = b * b - a * c;
    if (discriminant > 0.0) {
        float sqrtd = sqrt(discriminant);
        float t1 = (-b - sqrtd) / a;
        if (t1 < tMax && t1 > tMin) {
            t = t1;
            normal = (r.origin + r.dir * t - s.center) / s.radius;
            return true;
        }
        float t2 = (-b + sqrtd) / a;
        if (t2 < tMax && t2 > tMin) {
            t = t2;
            normal = (r.origin + r.dir * t - s.center) / s.radius;
            return true;
        }
    }
    return false;
}

bool sceneIntersect(Ray r, float tMin, float tMax, out float hitT, out vec3 hitNormal, out vec3 albedo) {
    hitT = tMax;
    bool hit = false;
    for (int i = 0; i < sphereCount; i++) {
        float t;
        vec3 n;
        if (hitSphere(spheres[i], r, tMin, hitT, t, n)) {
            hitT = t;
            hitNormal = n;
            albedo = spheres[i].albedo;
            hit = true;
        }
    }
    return hit;
}

// Cosine-weighted hemisphere sampling
vec3 randomHemisphereDir(vec3 normal) {
    float r1 = rand();
    float r2 = rand();
    float phi = 2.0 * 3.1415926535 * r1;
    float cosTheta = sqrt(1.0 - r2);
    float sinTheta = sqrt(r2);
    vec3 localDir = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    // Orthonormal basis from normal
    vec3 axis = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(axis, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * localDir.x + bitangent * localDir.y + normal * localDir.z;
}

const vec3 cameraPos = vec3(0.0, 0.5, 2.5);
const vec3 lookAt = vec3(0.0, 0.0, -1.0);
const vec3 up = vec3(0.0, 1.0, 0.0);
const float fov = 60.0;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    uint seed = uint(pc.time * 1000.0) + uint(pix.y * size.x + pix.x) * 1234567u + pc.frameNum * 789123u;
    init_rng(seed);

    vec3 color = vec3(0.0);
    int samplesPerFrame = pc.samplesPerFrame;

    for (int s = 0; s < samplesPerFrame; s++) {
        float aspect = float(size.x) / float(size.y);
        float focusDist = pc.focalDist;

        // Pixel coordinates with antialiasing
        float u = (float(pix.x) + rand()) / float(size.x);
        float v = (float(pix.y) + rand()) / float(size.y);

        // Camera basis
        vec3 forward = normalize(lookAt - cameraPos);
        vec3 right = normalize(cross(forward, up));
        vec3 camUp = cross(right, forward);

        float halfH = tan(radians(fov) * 0.5);
        float halfW = halfH * aspect;

        // Point on focal plane at distance focusDist
        vec3 filmPoint = cameraPos + forward * focusDist
                + right * (2.0 * u - 1.0) * halfW * focusDist
                + camUp * (2.0 * v - 1.0) * halfH * focusDist;

        Ray ray;
        ray.origin = cameraPos;
        ray.dir = normalize(filmPoint - cameraPos);

        vec3 throughput = vec3(1.0);
        const int maxBounces = 8;

        for (int bounce = 0; bounce < maxBounces; bounce++) {
            float t;
            vec3 normal, albedo;
            if (sceneIntersect(ray, 0.001, 1e20, t, normal, albedo)) {
                vec3 hitPos = ray.origin + ray.dir * t;
                vec3 newDir = randomHemisphereDir(normal);
                ray.origin = hitPos + normal * 0.001;
                ray.dir = newDir;

                // BRDF = albedo/pi, PDF = cos(theta)/pi -> factor = albedo
                throughput *= albedo;
            } else {
                // Sky
                float tSky = 0.5 * (ray.dir.y + 1.0);
                vec3 skyColor = mix(vec3(0.5, 0.7, 1.0), vec3(1.0), tSky);
                color += throughput * skyColor;
                break;
            }
        }
    }

    color /= float(samplesPerFrame);

    // Progressive accumulation
    vec3 prev = imageLoad(outputImage, pix).rgb;
    vec3 accum = prev * float(pc.frameNum) + color;
    accum /= float(pc.frameNum + 1);

    imageStore(outputImage, pix, vec4(accum, 1.0));
}
