#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D outputImage;

// Scene parameters (could be in a uniform buffer)
layout(push_constant) uniform PushConstants {
    float time; // for animation or random seed
    uint frameNum; // for accumulating samples
    float aperture; // depth of field (optional)
    float focalDist;
    int samplesPerFrame;
} pc;

// ------------------------------------------------------------------
// Random number generator (PCG)
uint rng_state;

void init_rng(uint seed, uint id) {
    rng_state = seed + id * 123456789u;
}

uint pcg_hash(uint inpt) {
    uint state =
        inpt * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand() {
    rng_state = pcg_hash(rng_state);
    return float(rng_state) / 4294967295.0f;
}
// ------------------------------------------------------------------

// Ray structure
struct Ray {
    vec3 origin;
    vec3 dir;
};

// Sphere
struct Sphere {
    vec3 center;
    float radius;
    vec3 albedo; // diffuse color
};

// Scene: hardcoded for simplicity (could come from a storage buffer)
const int sphereCount = 3;
Sphere spheres[sphereCount] = Sphere[sphereCount](
        Sphere(vec3(0.0, -100.5, -1.0), 100.0, vec3(0.8, 0.8, 0.8)), // floor
        Sphere(vec3(0.0, 0.0, -1.2), 0.5, vec3(1.0, 0.2, 0.2)), // red sphere
        Sphere(vec3(0.8, 0.3, -1.8), 0.4, vec3(0.2, 0.2, 1.0)) // blue sphere
    );

// Ray-sphere intersection
bool hitSphere(const Sphere s, Ray r, float tMin, float tMax, out float t, out vec3 normal) {
    vec3 oc = r.origin - s.center;
    float a = dot(r.dir, r.dir);
    float b = dot(oc, r.dir);
    float c = dot(oc, oc) - s.radius * s.radius;
    float discriminant = b * b - a * c;
    if (discriminant > 0.0) {
        float sqrtd = sqrt(discriminant);
        float t1 = (-b - sqrtd) / a;
        if (t1 < tMax && t1 > tMin) {
            t = t1;
            normal = (r.origin + r.dir * t - s.center) / s.radius;
            return true;
        }
        float t2 = (-b + sqrtd) / a;
        if (t2 < tMax && t2 > tMin) {
            t = t2;
            normal = (r.origin + r.dir * t - s.center) / s.radius;
            return true;
        }
    }
    return false;
}

// Find closest hit
bool sceneIntersect(Ray r, float tMin, float tMax, out float hitT, out vec3 hitNormal, out vec3 albedo) {
    hitT = tMax;
    bool hit = false;
    for (int i = 0; i < sphereCount; i++) {
        float t;
        vec3 n;
        if (hitSphere(spheres[i], r, tMin, hitT, t, n)) {
            hitT = t;
            hitNormal = n;
            albedo = spheres[i].albedo;
            hit = true;
        }
    }
    return hit;
}

// Generate a random direction in hemisphere (cosine-weighted)
vec3 randomHemisphereDir(vec3 normal, inout uint rng) {
    float r1 = rand(), r2 = rand();
    float z = sqrt(1.0 - r2);
    float phi = 2.0 * 3.1415926535 * r1;
    float x = cos(phi) * sqrt(r2);
    float y = sin(phi) * sqrt(r2);
    vec3 dir = vec3(x, y, z);
    // Orthonormal basis from normal
    vec3 axis = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(axis, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * dir.x + bitangent * dir.y + normal * dir.z;
}

// Camera
vec3 cameraPos = vec3(0.0, 0.5, 2.5);
vec3 lookAt = vec3(0.0, 0.0, -1.0);
vec3 up = vec3(0.0, 1.0, 0.0);
float fov = 60.0;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    // Initialize random seed based on pixel and frame
    uint seed = uint(pc.time * 1000.0) + uint(pix.y * size.x + pix.x) * 1234567u + pc.frameNum * 789123u;
    init_rng(seed, 0u);

    // Accumulated color
    vec3 color = vec3(0.0);

    // Number of samples per frame (we can accumulate over multiple frames)
    int samplesPerFrame = pc.samplesPerFrame; // increase if you want to do multiple paths per dispatch

    for (int s = 0; s < samplesPerFrame; s++) {
        // Compute camera ray with antialiasing
        float aspect = float(size.x) / float(size.y);
        float lensRadius = pc.aperture;
        float focusDist = pc.focalDist;

        // Pixel coordinates with random offset for AA
        float u = (float(pix.x) + rand()) / float(size.x);
        float v = (float(pix.y) + rand()) / float(size.y);

        // Camera basis
        vec3 w = normalize(cameraPos - lookAt);
        vec3 uVec = normalize(cross(up, w));
        vec3 vVec = cross(w, uVec);

        float halfH = tan(radians(fov) * 0.5);
        float halfW = halfH * aspect;

        vec3 filmP = cameraPos - w * focusDist;
        vec3 offset = uVec * (2.0 * u - 1.0) * halfW * focusDist + vVec * (2.0 * v - 1.0) * halfH * focusDist;
        vec3 pFocus = filmP + offset;

        // Simple pinhole camera (no DOF)
        Ray ray;
        ray.origin = cameraPos;
        ray.dir = normalize(pFocus - cameraPos);

        // Path tracing loop
        vec3 throughput = vec3(1.0);
        const int maxBounces = 8;
        for (int bounce = 0; bounce < maxBounces; bounce++) {
            float t;
            vec3 normal, albedo;
            if (sceneIntersect(ray, 0.001, 1e20, t, normal, albedo)) {
                vec3 hitPos = ray.origin + ray.dir * t;
                // Accumulate emission (none here) or direct lighting? We'll just do pure indirect.
                // For simplicity, we use cosine-weighted hemisphere sampling for diffuse.
                vec3 newDir = randomHemisphereDir(normal, rng_state);
                ray.origin = hitPos + normal * 0.001; // offset to avoid self-intersection
                ray.dir = newDir;
                throughput *= albedo * 2.0 * dot(newDir, normal); // factor 2 due to PDF (1/(2pi)) cancellation
            } else {
                // Sky (simple gradient)
                float tSky = 0.5 * (ray.dir.y + 1.0);
                vec3 skyColor = mix(vec3(0.5, 0.7, 1.0), vec3(1.0), tSky);
                color += throughput * skyColor;
                break;
            }
        }
    }

    // Average over samples per frame
    color /= float(samplesPerFrame);

    // Accumulate over frames: read previous value and add
    vec3 prev = imageLoad(outputImage, pix).rgb;
    float totalSamples = float(pc.frameNum + 1); // if frameNum starts at 0
    vec3 accum = prev * float(pc.frameNum) + color;
    accum /= totalSamples; // we'll store the accumulated value directly, but careful: we want progressive update.
    // Actually, simpler: just add and we'll divide in final display.
    // For incremental accumulation, we store the sum of colors and increment sample count separately.
    // Here we'll just store the running average: newAvg = (oldAvg * N + color) / (N+1)
    // But we don't have a separate sample count buffer. We'll use frameNum as sample count.
    imageStore(outputImage, pix, vec4(accum, 1.0));
}
